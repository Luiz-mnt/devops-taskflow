# Exemplo sem segredos. Configure no shell; a aplicação não lê .env automaticamente.
TASKFLOW_DB_PATH=./data/taskflow.db

# Compose lê estas variáveis do shell ou de .env; não há segredos neste exemplo.
# Para o deploy publicado, defina IMAGE_REF=ghcr.io/luiz-mnt/devops-taskflow@sha256:<digest-real>
# Para build local: IMAGE_REF=taskflow-local:teste e IMAGE_PULL_POLICY=never.
IMAGE_PULL_POLICY=always
TASKFLOW_RESOURCE_PREFIX=taskflow
API_PORT=8000
PROMETHEUS_PORT=9090
DEPLOY_TIMEOUT=120
SMOKE_TIMEOUT=90
